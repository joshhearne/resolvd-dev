---
const formId = import.meta.env.PUBLIC_LOOPS_FORM_ID || "";
---

<dialog
  id="waitlist-modal"
  data-form-id={formId}
  class="backdrop:bg-black/70 backdrop:backdrop-blur-sm bg-transparent p-0 max-w-lg w-full m-auto"
>
  <div class="relative rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xl shadow-black/50">
    <button
      type="button"
      data-waitlist-close
      aria-label="Close"
      class="absolute top-4 right-4 inline-flex h-8 w-8 items-center justify-center rounded-md text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] hover:bg-[var(--color-surface-2)] transition"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>

    <div data-waitlist-form-state class="p-7">
      <div class="flex items-center gap-2 mb-1">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand)] shadow-[0_0_8px_var(--color-brand)]"></span>
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-muted)]">Hosted waitlist</span>
      </div>
      <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg-strong)]">Get early access</h2>
      <p class="mt-2 text-sm text-[var(--color-fg-muted)] leading-relaxed">
        Drop your email. We'll reach out when your tier opens up — no spam, no drip campaigns until launch.
      </p>

      <form data-waitlist-form class="mt-6 space-y-4">
        <div>
          <label for="waitlist-email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-muted)] mb-2">Email</label>
          <input
            id="waitlist-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="w-full rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-4 py-2.5 text-sm text-[var(--color-fg-strong)] placeholder:text-[var(--color-fg-dim)] focus:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand)]/20 transition"
          />
        </div>

        <div>
          <label for="waitlist-name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-muted)] mb-2">Full name <span class="text-[var(--color-fg-dim)] normal-case font-normal">(optional)</span></label>
          <input
            id="waitlist-name"
            name="fullName"
            type="text"
            autocomplete="name"
            placeholder="Jane Smith"
            class="w-full rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-4 py-2.5 text-sm text-[var(--color-fg-strong)] placeholder:text-[var(--color-fg-dim)] focus:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand)]/20 transition"
          />
        </div>

        <div>
          <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-muted)] mb-2">Interested tier</span>
          <div class="grid grid-cols-3 gap-2" role="radiogroup">
            {[
              { id: "small" },
              { id: "team" },
              { id: "pro" },
            ].map(t => (
              <label class="cursor-pointer">
                <input type="radio" name="userGroup" value={t.id} class="peer sr-only" required />
                <span class="block text-center px-3 py-2 rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] text-sm font-semibold text-[var(--color-fg-muted)] capitalize hover:text-[var(--color-fg-strong)] peer-checked:border-[var(--color-brand)] peer-checked:bg-[var(--color-brand)]/10 peer-checked:text-[var(--color-brand)] transition">
                  {t.id}
                </span>
              </label>
            ))}
          </div>
        </div>

        <input type="hidden" name="source" value="pricing-page" />

        <div data-waitlist-error class="hidden rounded-lg border border-red-500/30 bg-red-500/5 px-4 py-3 text-sm text-red-400"></div>

        <button
          type="submit"
          class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-[var(--color-brand)] px-5 py-3 text-sm font-semibold text-[#062814] shadow-[0_0_24px_rgba(34,197,94,0.35)] hover:bg-[var(--color-brand-bright)] disabled:opacity-50 disabled:cursor-not-allowed transition"
        >
          <span data-waitlist-submit-label>Join waitlist</span>
          <svg data-waitlist-submit-spinner class="hidden animate-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round"/></svg>
        </button>

        <p class="text-xs text-[var(--color-fg-dim)] text-center">
          We use Loops for the waitlist. Unsubscribe anytime.
        </p>
      </form>
    </div>

    <div data-waitlist-success-state class="hidden p-7 text-center">
      <div class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-brand)]/15 text-[var(--color-brand)] mb-4">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
      </div>
      <h2 class="text-2xl font-bold tracking-tight text-[var(--color-fg-strong)]">You're on the list.</h2>
      <p class="mt-2 text-sm text-[var(--color-fg-muted)] leading-relaxed">
        We'll reach out when your tier opens. Check your inbox to confirm.
      </p>
      <button
        type="button"
        data-waitlist-close
        class="mt-6 inline-flex items-center justify-center rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-5 py-2.5 text-sm font-semibold text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)] transition"
      >
        Close
      </button>
    </div>
  </div>
</dialog>

<script is:inline>
(function () {
  var modal = document.getElementById("waitlist-modal");
  if (!modal) return;
  var formId = modal.getAttribute("data-form-id");
  var form = modal.querySelector("[data-waitlist-form]");
  var formState = modal.querySelector("[data-waitlist-form-state]");
  var successState = modal.querySelector("[data-waitlist-success-state]");
  var errorBox = modal.querySelector("[data-waitlist-error]");
  var submitLabel = modal.querySelector("[data-waitlist-submit-label]");
  var spinner = modal.querySelector("[data-waitlist-submit-spinner]");
  var submitBtn = form ? form.querySelector("button[type=submit]") : null;

  function open(tier) {
    if (formState) formState.classList.remove("hidden");
    if (successState) successState.classList.add("hidden");
    if (errorBox) errorBox.classList.add("hidden");
    if (form) form.reset();
    if (tier) {
      var radio = modal.querySelector('input[name="userGroup"][value="' + tier + '"]');
      if (radio) radio.checked = true;
    }
    if (typeof modal.showModal === "function") {
      modal.showModal();
    } else {
      modal.setAttribute("open", "");
    }
  }

  function close() {
    if (typeof modal.close === "function") modal.close();
    else modal.removeAttribute("open");
  }

  document.querySelectorAll("[data-waitlist-trigger]").forEach(function (el) {
    el.addEventListener("click", function (e) {
      e.preventDefault();
      open(el.getAttribute("data-tier") || "");
    });
  });

  modal.querySelectorAll("[data-waitlist-close]").forEach(function (el) {
    el.addEventListener("click", close);
  });

  modal.addEventListener("click", function (e) {
    if (e.target === modal) close();
  });

  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (errorBox) errorBox.classList.add("hidden");

      if (!formId) {
        if (errorBox) {
          errorBox.textContent = "Waitlist not configured yet. Email hosted@resolvd.dev.";
          errorBox.classList.remove("hidden");
        }
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = "Joining...";
      if (spinner) spinner.classList.remove("hidden");

      var data = new FormData(form);
      var body = new URLSearchParams();
      data.forEach(function (value, key) {
        if (key === "fullName") {
          var full = String(value).trim().replace(/\s+/g, " ");
          if (!full) return;
          var idx = full.indexOf(" ");
          if (idx === -1) {
            body.append("firstName", full);
          } else {
            body.append("firstName", full.slice(0, idx));
            body.append("lastName", full.slice(idx + 1));
          }
          return;
        }
        body.append(key, String(value));
      });

      fetch("https://app.loops.so/api/newsletter-form/" + formId, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: body.toString(),
      })
        .then(function (r) { return r.json().then(function (j) { return { status: r.status, ok: r.ok, json: j }; }, function () { return { status: r.status, ok: r.ok, json: null }; }); })
        .then(function (res) {
          if (res.ok && res.json && res.json.success) {
            if (formState) formState.classList.add("hidden");
            if (successState) successState.classList.remove("hidden");
          } else if (res.status === 429) {
            if (errorBox) {
              errorBox.textContent = "Too many signups right now. Try again in a minute.";
              errorBox.classList.remove("hidden");
            }
          } else {
            var msg = (res.json && (res.json.message || res.json.error)) || "Something went wrong. Try again.";
            if (errorBox) {
              errorBox.textContent = msg;
              errorBox.classList.remove("hidden");
            }
          }
        })
        .catch(function () {
          if (errorBox) {
            errorBox.textContent = "Network error. Try again.";
            errorBox.classList.remove("hidden");
          }
        })
        .finally(function () {
          if (submitBtn) submitBtn.disabled = false;
          if (submitLabel) submitLabel.textContent = "Join waitlist";
          if (spinner) spinner.classList.add("hidden");
        });
    });
  }
})();
</script>
