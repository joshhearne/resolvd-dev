---
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Overview" },
  { href: "/install/", label: "Install Wizard" },
  { href: "/manual/", label: "Manual Setup" },
  { href: "/docs/", label: "Docs" },
];
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[rgba(10,15,28,0.75)] backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 group">
      <img src="/icon.svg" alt="" width="32" height="32" class="rounded-lg shadow-[0_0_24px_rgba(34,197,94,0.25)] transition group-hover:shadow-[0_0_28px_rgba(34,197,94,0.45)]" />
      <span class="text-lg font-semibold tracking-tight">resolvd<span class="text-[var(--color-brand)]">.</span><span class="text-[var(--color-fg-muted)] font-normal">dev</span></span>
    </a>
    <ul class="hidden md:flex items-center gap-1 text-sm">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            class={`px-3 py-1.5 rounded-md transition ${isActive(l.href)
              ? "text-white bg-[var(--color-surface-2)] border border-[var(--color-border)]"
              : "text-[var(--color-fg-muted)] hover:text-white"}`}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a href="https://github.com/joshhearne/resolvd" target="_blank" rel="noopener" class="text-sm text-[var(--color-fg-muted)] hover:text-white px-3 py-1.5 rounded-md border border-[var(--color-border)] hover:border-[var(--color-border-strong)] transition">
        GitHub
      </a>
    </div>
  </nav>
</header>
