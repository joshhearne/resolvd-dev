---
import Layout from "../layouts/Layout.astro";

const crmFeatures = [
  {
    title: "Companies, scoped to projects",
    body: "Each vendor company belongs to a project and carries an optional `domain` used for inbound sender-domain matching. Move a ticket between projects → vendor contacts detach (vendor scope is project-bound).",
  },
  {
    title: "Contacts with real fields",
    body: "Name, email, phone, role / title — all encrypted under standard mode. Email also gets HMAC'd into a blind index so inbound webhooks can look up senders without decrypting the table.",
  },
  {
    title: "Generic mailbox blocklist",
    body: "`support@`, `helpdesk@`, `noreply@` and friends are rejected at write time to prevent reply loops with the vendor's own helpdesk. The list is extensible per workspace via `auth_settings.email_blocklist`.",
  },
  {
    title: "Attach contacts to tickets",
    body: "Attached contacts receive vendor-visible comments and can be CC'd in inbound creation flows. Attaching a contact does <em>not</em> auto-enroll them in status updates — that takes a Notify Vendor click first.",
  },
];

const events = [
  { event: "new_ticket", trigger: "Manual — Notify Vendor button", attachments: "Yes (images)" },
  { event: "new_comment", trigger: "Admin / Manager marks comment 'Share with vendor'", attachments: "Yes (images)" },
  { event: "status_change", trigger: "After first vendor outbound succeeds", attachments: "Body only" },
  { event: "ticket_resolved", trigger: "After first vendor outbound succeeds", attachments: "Body only" },
  { event: "ticket_reopened", trigger: "Auto-reopen or manual", attachments: "Body only" },
];

const companyPrefs = [
  { label: "Status change notifications", default: "on", behaviour: "Fires on `status_change` events" },
  { label: "Filter to specific statuses", default: "all", behaviour: "Uncheck \"All statuses\" to select individual status names" },
  { label: "Ticket resolved", default: "on", behaviour: "Fires on `ticket_resolved`" },
  { label: "Ticket reopened", default: "off", behaviour: "Fires on `ticket_reopened` (auto- or manual)" },
];
---

<Layout title="Vendor Coordination — Resolvd" description="Built-in CRM with vendor-aware comments, per-vendor pill colors, mute + daily digest, and per-company notification preferences.">
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-4xl px-6 pt-20 pb-12 md:pt-28">
      <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs text-[var(--color-fg-muted)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand)] shadow-[0_0_8px_var(--color-brand)]"></span>
        Vendor coordination
      </span>
      <h1 class="mt-2 text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]">
        Vendors. <span class="text-[var(--color-brand)]">In the ticket.</span>
      </h1>
      <p class="mt-6 text-lg text-[var(--color-fg-muted)] leading-relaxed max-w-2xl">
        A lightweight CRM lives next to your tickets — companies, contacts, vendor-visible comments, per-vendor color pills, mute + daily digest. Email loops back into the same thread, attributed and color-coded.
      </p>
      <div class="mt-10 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-[var(--color-brand)]/40 bg-[var(--color-brand)]/10 text-xs font-semibold text-[var(--color-brand)] tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand)]"></span> To Vendor
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-purple-400/40 bg-purple-400/10 text-xs font-semibold text-purple-300 tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-purple-300"></span> From Acme Corp
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-cyan-400/40 bg-cyan-400/10 text-xs font-semibold text-cyan-300 tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-300"></span> From BlueSky
        </span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-amber-400/40 bg-amber-400/10 text-xs font-semibold text-amber-300 tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span> From OrangePeel
        </span>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[500px] -z-10 opacity-[0.04]" style="background-image: linear-gradient(to right, var(--color-fg-strong) 1px, transparent 1px), linear-gradient(to bottom, var(--color-fg-strong) 1px, transparent 1px); background-size: 32px 32px;"></div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Built-in CRM</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Companies + contacts. <span class="text-[var(--color-brand)]">No second tool.</span></h2>
      </div>
      <div class="mt-10 grid md:grid-cols-2 gap-4">
        {crmFeatures.map(f => (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
            <h3 class="font-semibold text-[var(--color-fg-strong)] mb-2">{f.title}</h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed" set:html={f.body.replace(/`([^`]+)`/g, '<code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">$1</code>')}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Color-coded threads</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Same vendor, <span class="text-[var(--color-brand)]">same color</span>. Always.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Vendor-visible comments show a brand-colored <strong class="text-[var(--color-fg-strong)]">TO VENDOR</strong> pill. Inbound vendor replies (auto-ingested via email match) show a <strong class="text-[var(--color-fg-strong)]">FROM {`{company}`}</strong> pill in a deterministic per-vendor color hashed from the company id.
          </p>
          <ul class="mt-6 space-y-3 text-sm">
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span class="text-[var(--color-fg-muted)]">Same vendor → same color across users, sessions, and renders.</span></li>
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span class="text-[var(--color-fg-muted)]">Hue spread is theme-aware — pastel + dark text on light, muted dark + light text on dark.</span></li>
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span class="text-[var(--color-fg-muted)]">Skips the sickly yellow-green band so vendor pills never collide with the brand accent.</span></li>
            <li class="flex gap-3"><span class="text-[var(--color-brand)] font-mono">→</span><span class="text-[var(--color-fg-muted)]">Multiple vendors on one ticket stay distinct and readable.</span></li>
          </ul>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-1">
          <div class="rounded-lg bg-[#050810] p-5 text-xs leading-relaxed">
            <div class="font-mono text-[var(--color-fg-dim)]"># Ticket WEB-0042 thread</div>
            <div class="mt-4 space-y-3.5">
              <div class="flex items-start gap-2.5">
                <span class="inline-flex shrink-0 items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border border-[var(--color-brand)]/40 bg-[var(--color-brand)]/10 text-[var(--color-brand)]">To Vendor</span>
                <span class="text-[#cbd5e1]">Hi — could you confirm the SKU?</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="inline-flex shrink-0 items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border border-purple-400/40 bg-purple-400/10 text-purple-300">From Acme</span>
                <span class="text-[#cbd5e1]">Confirmed — part #88-A2.</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="inline-flex shrink-0 items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border border-cyan-400/40 bg-cyan-400/10 text-cyan-300">From BlueSky</span>
                <span class="text-[#cbd5e1]">We can stage by Friday.</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="inline-flex shrink-0 items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border border-purple-400/40 bg-purple-400/10 text-purple-300">From Acme</span>
                <span class="text-[#cbd5e1]">Tracking attached.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="max-w-2xl">
        <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Outbound discipline</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Notify Vendor is a <span class="text-[var(--color-brand)]">deliberate click</span>.</h2>
        <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
          Resolvd never auto-blasts a vendor on ticket creation. Staff review the ticket, then click Notify Vendor. After that first outbound, status-change and resolved updates fire automatically — but only because someone said the relationship is real.
        </p>
      </div>
      <div class="mt-10 overflow-x-auto rounded-xl border border-[var(--color-border)]">
        <table class="w-full text-sm">
          <thead class="bg-[var(--color-surface-2)] text-left text-xs uppercase tracking-wide text-[var(--color-fg-muted)]">
            <tr>
              <th class="px-4 py-3">Event</th>
              <th class="px-4 py-3">Trigger</th>
              <th class="px-4 py-3">Attachments</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            {events.map(e => (
              <tr>
                <td class="px-4 py-3 font-mono text-[var(--color-brand)]">{e.event}</td>
                <td class="px-4 py-3 text-[var(--color-fg-muted)]">{e.trigger}</td>
                <td class="px-4 py-3 text-[var(--color-fg-muted)]">{e.attachments}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-[var(--color-fg-dim)]">Internal-only comments never leak through templates — the renderer filters on <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">is_external_visible=true</code>.</p>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Mute + daily digest</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Noisy vendor? <span class="text-[var(--color-brand)]">Mute the firehose.</span></h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Toggle <strong class="text-[var(--color-fg-strong)]">Auto-mute vendor replies</strong> on a ticket. Matched vendor replies still land in the thread but with <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">is_muted=true</code>; the UI collapses them into a "N muted vendor replies" bucket. Followers don't get paged.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            A daily digest at the configured local time (default 15:00, configurable via <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">auth_settings.muted_digest_timezone</code>) catches up every follower with a summary of muted replies in the prior 24h. Admin / Manager can un-mute any single comment to bring it back into the main thread.
          </p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">Per-company prefs</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Tune notifications <span class="text-[var(--color-brand)]">per company</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Each company under Admin → Companies has a notification preferences panel:
          </p>
          <div class="mt-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] divide-y divide-[var(--color-border)]">
            {companyPrefs.map(p => (
              <div class="px-4 py-3 flex items-start gap-3">
                <span class="font-mono text-xs text-[var(--color-brand)] mt-0.5">{p.default === "on" ? "✓" : p.default === "off" ? "—" : "▸"}</span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline justify-between gap-3">
                    <span class="text-sm font-medium text-[var(--color-fg-strong)]">{p.label}</span>
                    <span class="text-[10px] uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">{p.default}</span>
                  </div>
                  <p class="mt-0.5 text-xs text-[var(--color-fg-muted)] leading-relaxed" set:html={p.behaviour.replace(/`([^`]+)`/g, '<code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">$1</code>')}></p>
                </div>
              </div>
            ))}
          </div>
          <p class="mt-3 text-xs text-[var(--color-fg-dim)]"><code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">new_ticket</code> and <code class="text-xs px-1 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">new_comment</code> always send regardless of company prefs — those are explicitly triggered by staff.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div>
          <span class="text-xs uppercase tracking-wider text-[var(--color-fg-dim)] font-semibold">On phone calls?</span>
          <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">Spell ticket refs <span class="text-[var(--color-brand)]">cleanly</span>.</h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Hover or focus any ticket reference in the UI to get a NATO phonetic readback popover — <code class="text-xs px-1.5 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-brand)]">WEB-0079</code> reads as "Whiskey Echo Bravo · 0 0 7 9". Letters become NATO words; digits and dashes stay as-is. Toggleable per-org and per-user.
          </p>
          <p class="mt-4 text-sm text-[var(--color-fg-muted)] leading-relaxed">
            Need phonetic spelling outside Resolvd — for serial numbers, license plates, confirmation codes? Pair with <a href="https://alphabetsoup.app" target="_blank" rel="noopener" class="text-[var(--color-brand)] hover:underline">AlphabetSoup</a>, a standalone NATO parser by the same team. Web app today; browser extensions on the roadmap.
          </p>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-1">
          <div class="rounded-lg bg-[#050810] p-5 font-mono text-xs leading-relaxed">
            <div class="text-[var(--color-fg-dim)]"># Hover popover</div>
            <div class="mt-3 text-[#cbd5e1]">
              <span class="text-emerald-300">WEB-0079</span><br /><br />
              <span class="text-violet-300">Whiskey Echo Bravo</span><br />
              <span class="text-violet-300">- 0 0 7 9</span>
            </div>
            <div class="mt-5 text-[var(--color-fg-muted)] leading-relaxed">
              <span class="text-[var(--color-brand)]">▸</span> Org: <span class="text-emerald-300">enabled</span><br />
              <span class="text-[var(--color-brand)]">▸</span> Per-user: <span class="text-emerald-300">on</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Set up your first vendor.</h2>
      <p class="mt-4 text-[var(--color-fg-muted)]">Admin → Companies → New. Add contacts, attach to tickets, click Notify Vendor when you're ready to engage.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/install/" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[var(--color-brand)] px-5 py-3 text-sm font-semibold text-[#062814] shadow-[0_0_24px_rgba(34,197,94,0.35)] hover:bg-[var(--color-brand-bright)] transition">
          Install guide
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href="/email/" class="inline-flex items-center justify-center rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-3 text-sm font-semibold text-[var(--color-fg-strong)] hover:bg-[var(--color-surface-2)] transition">
          Email pipeline →
        </a>
      </div>
    </div>
  </section>
</Layout>
