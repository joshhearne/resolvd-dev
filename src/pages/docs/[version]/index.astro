---
import Layout from "../../../layouts/Layout.astro";
import DocsShell from "../../../components/DocsShell.astro";
import { listVersions, listTopics, topicSlug, getLatestVersion } from "../../../lib/docs";

export async function getStaticPaths() {
  const versions = await listVersions();
  return versions.map(v => ({ params: { version: v } }));
}

const { version } = Astro.params;
const topics = await listTopics(version!);
const latest = await getLatestVersion();
const isLatest = version === latest;
---

<Layout title={`Docs ${version} — Resolvd`} description={`Resolvd documentation for ${version}.`}>
  <DocsShell version={version!}>
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs px-2 py-0.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-brand)]">{version}</span>
        {isLatest && <span class="text-[10px] uppercase tracking-wider text-emerald-400 font-semibold">Latest</span>}
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight">Documentation</h1>
      <p class="mt-3 text-[var(--color-fg-muted)]">Reference for env vars, roles, operations, and troubleshooting at <span class="font-mono text-[var(--color-fg-strong)]">{version}</span>.</p>
    </header>
    <ul class="grid sm:grid-cols-2 gap-3">
      {topics.map(t => {
        const slug = topicSlug(t);
        return (
          <li>
            <a href={`/docs/${version}/${slug}/`} class="block rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-border-strong)] hover:bg-[var(--color-surface-2)] transition">
              <div class="font-semibold text-[var(--color-fg-strong)]">{t.data.title}</div>
              {t.data.summary && <p class="mt-1.5 text-sm text-[var(--color-fg-muted)] leading-relaxed">{t.data.summary}</p>}
            </a>
          </li>
        );
      })}
    </ul>
  </DocsShell>
</Layout>
