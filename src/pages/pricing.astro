---
import Layout from "../layouts/Layout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";

const tiers = [
  {
    id: "small",
    name: "Hosted Small",
    tagline: "Small teams getting started.",
    monthly: 25,
    annual: 250,
    annualMonthly: "20.83",
    highlights: [
      "Up to 5 users",
      "5 GB attachments",
      "Daily backups",
      "Custom subdomain",
      "Community support",
    ],
    featured: false,
  },
  {
    id: "team",
    name: "Hosted Team",
    tagline: "Growing teams that ship.",
    monthly: 50,
    annual: 500,
    annualMonthly: "41.67",
    highlights: [
      "Up to 25 users",
      "25 GB attachments",
      "Daily backups",
      "Custom domain",
      "Email support",
    ],
    featured: true,
  },
  {
    id: "pro",
    name: "Hosted Pro",
    tagline: "Bigger teams, stricter ops.",
    monthly: 150,
    annual: 1500,
    annualMonthly: "125",
    highlights: [
      "Unlimited users",
      "100 GB attachments",
      "Daily backups + 30-day retention",
      "Custom domain + SSO add-on",
      "Priority support",
    ],
    featured: false,
  },
];

const compareGroups = [
  {
    label: "Pricing",
    rows: [
      { feature: "Monthly", small: "$25/mo", team: "$50/mo", pro: "$150/mo" },
      { feature: "Annual (2 months free)", small: "$250/yr", team: "$500/yr", pro: "$1,500/yr" },
      { feature: "Effective annual rate", small: "$20.83/mo", team: "$41.67/mo", pro: "$125/mo" },
    ],
  },
  {
    label: "Capacity",
    rows: [
      { feature: "Active users", small: "5", team: "25", pro: "Unlimited" },
      { feature: "Attachment storage", small: "5 GB", team: "25 GB", pro: "100 GB (expandable)" },
      { feature: "Tickets / month", small: "10k soft limit", team: "50k soft limit", pro: "Unlimited" },
      { feature: "Contacts & organizations", small: true, team: true, pro: true, valueAll: "Unlimited" },
    ],
  },
  {
    label: "Backups & data",
    rows: [
      { feature: "Daily Postgres + uploads snapshot", small: true, team: true, pro: true },
      { feature: "Point-in-time retention", small: "7 days", team: "14 days", pro: "30 days" },
      { feature: "One-click export (SQL + tarball)", small: true, team: true, pro: true },
      { feature: "S3 destination for backups", small: false, team: "Optional", pro: "Customer-managed bucket" },
      { feature: "Quarterly restore drill report", small: false, team: false, pro: true },
    ],
  },
  {
    label: "Domain & access",
    rows: [
      { feature: "Custom domain", small: "Subdomain only", team: "Bring your own (CNAME)", pro: "Bring your own (CNAME)" },
      { feature: "TLS managed automatically", small: true, team: true, pro: true },
      { feature: "Email + magic-link auth", small: true, team: true, pro: true },
      { feature: "Webhooks & API tokens", small: false, team: true, pro: true },
      { feature: "SAML / OIDC SSO", small: false, team: false, pro: "Add-on" },
      { feature: "SCIM user provisioning", small: false, team: false, pro: true },
      { feature: "IP allowlists", small: false, team: false, pro: true },
    ],
  },
  {
    label: "Support",
    rows: [
      { feature: "Community Discord", small: true, team: true, pro: true },
      { feature: "GitHub issues triage", small: true, team: true, pro: true },
      { feature: "Email support", small: false, team: true, pro: true },
      { feature: "Priority email + chat", small: false, team: false, pro: true },
      { feature: "Bug response SLA", small: "48 hours", team: "24 hours", pro: "4 hours (P1)" },
      { feature: "Migration assistance from self-hosted", small: false, team: true, pro: true },
      { feature: "Onboarding session", small: false, team: false, pro: true },
      { feature: "Named ops escalation contact", small: false, team: false, pro: true },
    ],
  },
];

const faqs = [
  {
    q: "What's the difference between self-hosted and hosted?",
    a: "Same source-available code (FSL-1.1). Self-hosted runs on your hardware — free, you own ops. Hosted means we run the same build on managed infra so you don't touch a server.",
  },
  {
    q: "Why flat per-instance pricing instead of per-seat?",
    a: "Per-seat pricing punishes you for inviting collaborators. Flat instance tiers are predictable and don't penalize team growth inside your tier.",
  },
  {
    q: "Can I switch between monthly and annual?",
    a: "Yes. Upgrades (monthly → annual, or smaller → bigger plan) apply immediately with prorated credit. Downgrades take effect at the end of your current billing period.",
  },
  {
    q: "What happens if I cancel?",
    a: "Service runs through the end of your paid term. We don't refund partial periods, monthly or annual. Export your data anytime — it's yours.",
  },
  {
    q: "Can I move from hosted to self-hosted later?",
    a: "Yes. Same code, same schema. We'll hand you a Postgres dump and uploads tarball. Drop it into your self-hosted instance and you're running.",
  },
  {
    q: "Do you read my tickets?",
    a: "No. Your data is yours. We access instances only when you ask us to — for support or recovery — and only with your authorization.",
  },
];
---

<Layout>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-20 pb-12 md:pt-28">
      <div class="flex flex-col items-center text-center">
        <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-xs text-[var(--color-fg-muted)]">
          <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-brand)] shadow-[0_0_8px_var(--color-brand)]"></span>
          Hosted plans — managed infra, same source-available code
        </span>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.05] max-w-3xl">
          Flat pricing. <span class="text-[var(--color-brand)]">No per-seat tax.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-[var(--color-fg-muted)] leading-relaxed">
          Don't want to run a server? Pick a tier, we host it. Self-hosting stays free forever.
        </p>

        <div class="mt-10 inline-flex items-center gap-1 p-1 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)]" role="tablist" aria-label="Billing period">
          <button id="billing-monthly" type="button" role="tab" aria-selected="false" class="px-4 py-2 text-sm font-medium rounded-md text-[var(--color-fg-muted)] hover:text-[var(--color-fg-strong)] transition">
            Monthly
          </button>
          <button id="billing-annual" type="button" role="tab" aria-selected="true" class="px-4 py-2 text-sm font-medium rounded-md bg-[var(--color-surface-2)] text-[var(--color-fg-strong)] border border-[var(--color-border)] transition">
            Annual <span class="ml-1.5 text-xs text-[var(--color-brand)]">2 months free</span>
          </button>
        </div>
      </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[500px] -z-10 opacity-[0.04]" style="background-image: linear-gradient(to right, var(--color-fg-strong) 1px, transparent 1px), linear-gradient(to bottom, var(--color-fg-strong) 1px, transparent 1px); background-size: 32px 32px;"></div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-6 pb-20">
      <div class="grid md:grid-cols-3 gap-4">
        {tiers.map(t => (
          <div
            data-tier={t.id}
            data-monthly={t.monthly}
            data-annual={t.annual}
            data-annual-monthly={t.annualMonthly}
            class={`relative rounded-xl border p-7 flex flex-col ${t.featured
              ? "border-[var(--color-brand)] bg-[var(--color-surface)] shadow-[0_0_40px_rgba(34,197,94,0.15)]"
              : "border-[var(--color-border)] bg-[var(--color-surface)]"}`}
          >
            {t.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 text-xs font-semibold rounded-full bg-[var(--color-brand)] text-[#062814]">
                Most popular
              </span>
            )}
            <div>
              <h3 class="text-xl font-bold tracking-tight">{t.name}</h3>
              <p class="mt-1 text-sm text-[var(--color-fg-muted)]">{t.tagline}</p>
            </div>
            <div class="mt-6">
              <div class="flex items-baseline gap-1.5">
                <span class="text-5xl font-bold tracking-tight tabular-nums price-display">${t.annualMonthly}</span>
                <span class="text-[var(--color-fg-muted)] text-sm">/mo</span>
              </div>
              <p class="mt-1.5 text-xs text-[var(--color-fg-dim)] price-suffix">
                ${t.annual}/year · billed annually
              </p>
            </div>
            <ul class="mt-7 space-y-3 text-sm flex-1">
              {t.highlights.map(f => (
                <li class="flex gap-2.5">
                  <span class="text-[var(--color-brand)] font-mono mt-0.5">✓</span>
                  <span class="text-[var(--color-fg-muted)]">{f}</span>
                </li>
              ))}
            </ul>
            <button
              type="button"
              data-waitlist-trigger
              data-tier={t.id}
              class={`mt-7 inline-flex items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition ${t.featured
                ? "bg-[var(--color-brand)] text-[#062814] hover:bg-[var(--color-brand-bright)] shadow-[0_0_24px_rgba(34,197,94,0.35)]"
                : "border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] text-[var(--color-fg-strong)] hover:bg-[var(--color-surface)]"}`}
            >
              Join waitlist
            </button>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-[var(--color-fg-muted)]">
        Hosted launching soon. Join the waitlist and we'll reach out when your tier opens.
      </p>

      <details class="group mt-14 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]">
        <summary class="cursor-pointer list-none flex items-center justify-between gap-4 px-6 py-5 hover:bg-[var(--color-surface-2)] transition rounded-xl">
          <div>
            <h3 class="text-lg font-bold tracking-tight">Compare all features</h3>
            <p class="mt-1 text-sm text-[var(--color-fg-muted)]">Full breakdown across Small, Team, and Pro.</p>
          </div>
          <span class="flex items-center gap-2 text-sm font-semibold text-[var(--color-fg-muted)] group-hover:text-[var(--color-fg-strong)]">
            <span class="group-open:hidden">Expand</span>
            <span class="hidden group-open:inline">Collapse</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-open:rotate-180 transition-transform"><path d="M6 9l6 6 6-6"/></svg>
          </span>
        </summary>
        <div class="hidden md:block border-t border-[var(--color-border)] px-4 pb-2 overflow-x-auto">
          <table class="w-full text-sm border-separate border-spacing-0">
            <thead>
              <tr class="text-left">
                <th class="sticky left-0 bg-[var(--color-surface)] px-4 py-4 text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-dim)] w-[34%]">Feature</th>
                <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-strong)] text-center">Small</th>
                <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-center">
                  <span class="text-[var(--color-brand)]">Team</span>
                  <span class="ml-1.5 inline-block px-1.5 py-0.5 text-[9px] rounded bg-[var(--color-brand)] text-[#062814] tracking-wider">POPULAR</span>
                </th>
                <th class="px-4 py-4 text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-strong)] text-center">Pro</th>
              </tr>
            </thead>
            <tbody>
              {compareGroups.map(g => (
                <Fragment>
                  <tr>
                    <td colspan="4" class="px-4 pt-7 pb-2 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-brand)]">{g.label}</td>
                  </tr>
                  {g.rows.map(r => (
                    <tr class="border-t border-[var(--color-border)]">
                      <td class="sticky left-0 bg-[var(--color-surface)] px-4 py-3.5 text-[var(--color-fg-strong)] border-t border-[var(--color-border)]">{r.feature}</td>
                      {(["small","team","pro"] as const).map(k => {
                        const v = r.valueAll ?? r[k];
                        return (
                          <td class="px-4 py-3.5 text-center border-t border-[var(--color-border)]">
                            {v === true ? (
                              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-[var(--color-brand)]/15 text-[var(--color-brand)] font-mono text-xs">✓</span>
                            ) : v === false ? (
                              <span class="text-[var(--color-fg-dim)] font-mono">—</span>
                            ) : (
                              <span class="text-[var(--color-fg-muted)] tabular-nums">{v}</span>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </Fragment>
              ))}
            </tbody>
          </table>
        </div>

        <div class="md:hidden border-t border-[var(--color-border)] divide-y divide-[var(--color-border)]">
          {tiers.map(t => (
            <details class="group/tier" open={t.featured}>
              <summary class="cursor-pointer list-none flex items-center justify-between gap-3 px-5 py-4 hover:bg-[var(--color-surface-2)] transition">
                <div class="flex items-center gap-2">
                  <span class={`text-base font-bold tracking-tight ${t.featured ? "text-[var(--color-brand)]" : "text-[var(--color-fg-strong)]"}`}>{t.name.replace("Hosted ", "")}</span>
                  {t.featured && <span class="px-1.5 py-0.5 text-[9px] font-semibold rounded bg-[var(--color-brand)] text-[#062814] tracking-wider">POPULAR</span>}
                </div>
                <div class="flex items-center gap-2.5">
                  <span class="text-sm tabular-nums text-[var(--color-fg-muted)]">${t.annualMonthly}<span class="text-[var(--color-fg-dim)]">/mo</span></span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--color-fg-muted)] group-open/tier:rotate-180 transition-transform"><path d="M6 9l6 6 6-6"/></svg>
                </div>
              </summary>
              <div class="px-5 pb-5 pt-1 space-y-4">
                {compareGroups.filter(g => g.label !== "Pricing").map(g => (
                  <div>
                    <h4 class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-brand)] mb-2">{g.label}</h4>
                    <ul class="space-y-1.5 text-[13px]">
                      {g.rows.map(r => {
                        const v = r.valueAll ?? r[t.id as "small"|"team"|"pro"];
                        if (v === false) return null;
                        return (
                          <li class="flex items-start justify-between gap-3">
                            <span class="text-[var(--color-fg-muted)] flex items-start gap-2">
                              <span class="text-[var(--color-brand)] font-mono mt-0.5 text-xs">✓</span>
                              <span>{r.feature}</span>
                            </span>
                            {v !== true && (
                              <span class="text-[var(--color-fg-strong)] tabular-nums text-right shrink-0 text-xs">{v}</span>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      </details>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-5xl px-6 py-20">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Prefer to <span class="text-[var(--color-brand)]">self-host?</span></h2>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            Resolvd is source-available under the <a href="/license/" class="text-[var(--color-brand)] hover:underline">Functional Source License (FSL-1.1)</a>. Free to self-host, fork, and use internally — no fees, no seat caps. Auto-converts to Apache 2.0 after 2 years.
          </p>
          <p class="mt-4 text-[var(--color-fg-muted)] leading-relaxed">
            The hosted plans are a convenience for teams that don't want to run a server. The code is the same in both directions, and you can move between them anytime.
          </p>
          <div class="mt-6 flex gap-3">
            <a href="/install/" class="inline-flex items-center justify-center gap-2 rounded-lg bg-[var(--color-brand)] px-5 py-3 text-sm font-semibold text-[#062814] shadow-[0_0_24px_rgba(34,197,94,0.35)] hover:bg-[var(--color-brand-bright)] transition">
              Install guide
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            <a href="https://github.com/joshhearne/resolvd" target="_blank" rel="noopener" class="inline-flex items-center justify-center rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-3 text-sm font-semibold text-[var(--color-fg-strong)] hover:bg-[var(--color-surface-2)] transition">
              GitHub
            </a>
          </div>
        </div>
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-1">
          <div class="rounded-lg bg-[#050810] p-5 font-mono text-xs leading-relaxed">
            <div class="text-[var(--color-fg-dim)]"># self-host on any docker host</div>
            <div class="mt-2 text-[#cbd5e1]">
              <span class="text-emerald-300">git</span> clone <span class="text-violet-300">github.com/joshhearne/resolvd</span><br />
              <span class="text-emerald-300">cd</span> resolvd<br />
              <span class="text-emerald-300">cp</span> .env.example .env  <span class="text-[var(--color-fg-dim)]"># edit secrets</span><br />
              <span class="text-emerald-300">docker</span> compose up -d --build
            </div>
            <div class="mt-4 text-[var(--color-fg-muted)]">
              <span class="text-[var(--color-brand)]">▸</span> ~400 MB RAM idle<br />
              <span class="text-[var(--color-brand)]">▸</span> Postgres + Node + nginx<br />
              <span class="text-[var(--color-brand)]">▸</span> Free to self-host · FSL-1.1
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center">Questions, answered.</h2>
      <div class="mt-12 grid gap-3">
        {faqs.map(f => (
          <details class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5 hover:border-[var(--color-border-strong)] transition">
            <summary class="cursor-pointer flex items-center justify-between gap-4 font-semibold text-[var(--color-fg-strong)] list-none">
              <span>{f.q}</span>
              <span class="text-[var(--color-brand)] font-mono text-lg group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-sm text-[var(--color-fg-muted)] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
  (function () {
    var monthlyBtn = document.getElementById("billing-monthly");
    var annualBtn = document.getElementById("billing-annual");
    if (!monthlyBtn || !annualBtn) return;

    var activeClass = ["bg-[var(--color-surface-2)]", "text-[var(--color-fg-strong)]", "border", "border-[var(--color-border)]"];
    var inactiveClass = ["text-[var(--color-fg-muted)]", "hover:text-[var(--color-fg-strong)]"];

    function setActive(btn, isActive) {
      btn.setAttribute("aria-selected", isActive ? "true" : "false");
      var add = isActive ? activeClass : inactiveClass;
      var remove = isActive ? inactiveClass : activeClass;
      add.forEach(function (c) { btn.classList.add(c); });
      remove.forEach(function (c) { btn.classList.remove(c); });
    }

    function render(period) {
      setActive(annualBtn, period === "annual");
      setActive(monthlyBtn, period === "monthly");
      var cards = document.querySelectorAll("[data-tier]");
      cards.forEach(function (card) {
        var price = card.querySelector(".price-display");
        var suffix = card.querySelector(".price-suffix");
        if (!price || !suffix) return;
        if (period === "annual") {
          price.textContent = "$" + card.getAttribute("data-annual-monthly");
          suffix.textContent = "$" + card.getAttribute("data-annual") + "/year · billed annually";
        } else {
          price.textContent = "$" + card.getAttribute("data-monthly");
          suffix.textContent = "Billed monthly · switch to annual to save 2 months";
        }
      });
    }

    monthlyBtn.addEventListener("click", function () { render("monthly"); });
    annualBtn.addEventListener("click", function () { render("annual"); });
    render("annual");
  })();
</script>

  <WaitlistModal />
</Layout>
