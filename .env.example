# Loops.so newsletter form ID for the hosted-tier waitlist modal.
# Create a newsletter form in Loops with fields: email, firstName, tier (custom property).
# https://app.loops.so → Forms → Newsletter Form → copy the form ID from the URL.
PUBLIC_LOOPS_FORM_ID=

# Optional GitHub token for fetching app releases at build time.
# Anonymous = 60 req/hr per IP. With a fine-grained read-only token = 5000/hr.
# Required for Vercel/Netlify if builds get rate-limited.
# Generate: github.com/settings/tokens → Fine-grained → "Public Repositories (read-only)".
GITHUB_TOKEN=
